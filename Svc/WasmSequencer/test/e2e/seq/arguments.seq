; One command for each kind of argument, at the edges of each type's range.

; Every scalar type, minimum and maximum
R00:00:00 Ref.typeDemo.SEND_SCALARS {i8: -128, i16: -32768, i32: -2147483648, i64: -9223372036854775808, u8: 0, u16: 0, u32: 0, u64: 0, f32: -3.4028234663852886e38, f64: -1.7976931348623157e308}
R00:00:00 Ref.typeDemo.SEND_SCALARS {i8: 127, i16: 32767, i32: 2147483647, i64: 9223372036854775807, u8: 255, u16: 65535, u32: 4294967295, u64: 18446744073709551615, f32: 3.4028234663852886e38, f64: 1.7976931348623157e308}
R00:00:00 Ref.typeDemo.SEND_SCALARS {i8: 0, i16: -1, i32: 0x7F, i64: -42, u8: 0x10, u16: 1000, u32: 123456789, u64: 1, f32: 0.1, f64: 1e-300}

